project.manifest = manifest.xml

# Launcher icons are per-device-size. Garmin warns and rescales when the
# bitmap does not match the size a device declares, so instead of one
# icon stretched 40->70 px there is one folder per declared size and each
# device points at its own. resources/ carries everything else.
#
# Generated - see RELEASE.md. Adding a device means adding its line here.

